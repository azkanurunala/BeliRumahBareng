// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  phoneNumber        String
  avatarUrl          String
  avatarHint         String
  passwordHash       String?
  oauthProvider      String?
  oauthId            String?
  role               Int      @default(1) // 1 = user biasa, 2 = admin
  locationPreference String
  priceRange         String
  investmentGoals    String
  financialCapacity  String
  timeHorizon        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  projectsAsMember      ProjectMember[]
  interests             PropertyInterest[]
  submissions           PropertySubmission[]
  submissionReviews     PropertySubmission[] @relation("SubmissionReviewer")
  watchlists            Watchlist[]
  payments              Payment[]
  paymentPlans          PaymentPlan[]
  uploadedDocs          ProjectDocument[] @relation("DocumentUploader")
  verifiedPayments      Payment[] @relation("PaymentVerifier")
  notifications         Notification[]
  unitAssignments       UnitAssignment[] @relation("UnitOwner")
  checklistCompletions  ProgressChecklistItem[] @relation("ChecklistCompleter")
  progressCompletions   ProgressCompletedMember[] @relation("ProgressCompleter")
  documentSignatures    DocumentSignature[] @relation("DocumentSigner")
  messages              ProjectMessage[] @relation("MessageSender")
}

model Property {
  id                  String   @id @default(cuid())
  name                String
  description         String   @db.Text
  price               Decimal  @db.Decimal(15, 2)
  totalArea           Decimal?  @db.Decimal(10, 2)
  location            String
  type                String
  totalUnits          Int?
  unitName            String
  unitSize            Decimal? @db.Decimal(10, 2)
  unitMeasure         String?
  sitePlanUrl         String?
  sitePlanHint        String?
  developmentPlan     String?  @db.Text
  environmentalAnalysis String? @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  images      PropertyImage[]
  projects    Project[]
  interests   PropertyInterest[]
  watchlists  Watchlist[]
}

model PropertyImage {
  id          String   @id @default(cuid())
  propertyId  String
  url         String
  hint        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  // Relations
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Project {
  id              String   @id @default(cuid())
  propertyId      String
  propertyName    String
  propertyImageUrl String
  propertyImageHint String
  status          String?
  kycProgress     Int      @default(0)
  fundingProgress Int      @default(0)
  legalProgress   Int      @default(0)
  closingProgress Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  property        Property @relation(fields: [propertyId], references: [id])
  members         ProjectMember[]
  unitAssignments UnitAssignment[]
  documents       ProjectDocument[]
  paymentPlans    PaymentPlan[]
  progressDetails ProgressDetail[]
  messages        ProjectMessage[]
  payments        Payment[]
}

model PaymentPlan {
  id              String   @id @default(cuid())
  projectId       String
  userId          String
  unitId          Int
  type            String
  totalAmount     Decimal  @db.Decimal(15, 2)
  downPayment     Decimal? @db.Decimal(15, 2)
  installmentAmount Decimal? @db.Decimal(15, 2)
  totalInstallments Int?
  startDate       DateTime?
  endDate         DateTime?
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  project         Project  @relation(fields: [projectId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
  payments        Payment[]

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model Payment {
  id              String   @id @default(cuid())
  paymentPlanId   String?
  projectId       String
  userId          String
  unitId          Int
  amount          Decimal  @db.Decimal(15, 2)
  paymentDate     DateTime?
  dueDate         DateTime?
  period          String?
  status          String
  paymentMethod   String?
  receiptUrl      String?  @db.Text
  paymentReference String?
  notes           String?  @db.Text
  verifiedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  paymentPlan     PaymentPlan? @relation(fields: [paymentPlanId], references: [id])
  project         Project      @relation(fields: [projectId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  verifier        User?        @relation("PaymentVerifier", fields: [verifiedBy], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([paymentPlanId])
  @@index([status])
  @@index([period])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String   @db.Text
  href        String?
  type        String
  read        Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([type])
}

model PropertySubmission {
  id            String   @id @default(cuid())
  submittedBy   String
  type          String
  name          String
  description   String   @db.Text
  location      String
  totalArea     Decimal? @db.Decimal(10, 2)
  totalUnits    Int?
  unitSize      Decimal? @db.Decimal(10, 2)
  unitMeasure   String?
  askingPrice   Decimal  @db.Decimal(15, 2)
  contactPerson String
  contactPhone  String
  contactEmail  String
  status        String
  reviewedBy    String?
  reviewedAt    DateTime?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  submitter     User     @relation(fields: [submittedBy], references: [id])
  reviewer      User?    @relation("SubmissionReviewer", fields: [reviewedBy], references: [id])
  images        PropertySubmissionImage[]

  @@index([submittedBy])
  @@index([status])
  @@index([createdAt])
}

model PropertySubmissionImage {
  id                  String   @id @default(cuid())
  propertySubmissionId String
  url                 String
  hint                String
  order               Int      @default(0)
  createdAt           DateTime @default(now())

  // Relations
  propertySubmission  PropertySubmission @relation(fields: [propertySubmissionId], references: [id], onDelete: Cascade)

  @@index([propertySubmissionId])
}

model ProgressDetail {
  id          String   @id @default(cuid())
  projectId   String
  category    String
  title       String
  percentage  Int      @default(0)
  description String?  @db.Text
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklist   ProgressChecklistItem[]
  completedMembers ProgressCompletedMember[]
  milestones  ProgressMilestone[]

  @@unique([projectId, category])
  @@index([projectId])
  @@index([category])
}

model ProgressChecklistItem {
  id              String   @id @default(cuid())
  progressDetailId String
  label           String
  completed       Boolean  @default(false)
  completedBy     String?
  completedAt     DateTime?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  progressDetail  ProgressDetail @relation(fields: [progressDetailId], references: [id], onDelete: Cascade)
  completer       User?         @relation("ChecklistCompleter", fields: [completedBy], references: [id])

  @@index([progressDetailId])
  @@index([completed])
}

model ProgressCompletedMember {
  id              String   @id @default(cuid())
  progressDetailId String
  userId          String
  completedAt     DateTime @default(now())

  // Relations
  progressDetail  ProgressDetail @relation(fields: [progressDetailId], references: [id], onDelete: Cascade)
  user            User           @relation("ProgressCompleter", fields: [userId], references: [id])

  @@unique([progressDetailId, userId])
  @@index([progressDetailId])
  @@index([userId])
}

model ProgressMilestone {
  id              String   @id @default(cuid())
  progressDetailId String
  label           String
  date            DateTime?
  status          String
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  progressDetail  ProgressDetail @relation(fields: [progressDetailId], references: [id], onDelete: Cascade)

  @@index([progressDetailId])
  @@index([status])
}

model ProjectDocument {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  status      String
  url         String?  @db.Text
  uploadDate  DateTime?
  size        Int?
  description String?  @db.Text
  uploadedBy  String?
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader    User?    @relation("DocumentUploader", fields: [uploadedBy], references: [id])
  signatures  DocumentSignature[]

  @@index([projectId])
  @@index([status])
  @@index([uploadedBy])
}

model DocumentSignature {
  id          String   @id @default(cuid())
  documentId  String
  userId      String
  signedAt    DateTime @default(now())

  // Relations
  document    ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User           @relation("DocumentSigner", fields: [userId], references: [id])

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String?
  joinedAt  DateTime @default(now())

  // Relations
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model UnitAssignment {
  id        String   @id @default(cuid())
  projectId String
  unitId    Int
  userId    String
  price     Decimal  @db.Decimal(15, 2)
  size      Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation("UnitOwner", fields: [userId], references: [id])

  @@unique([projectId, unitId])
  @@index([projectId])
  @@index([userId])
}

model PropertyInterest {
  id          String   @id @default(cuid())
  propertyId  String
  userId      String
  unitId      Int?
  unitSize    Decimal? @db.Decimal(10, 2)
  isFirstHome Boolean  @default(false)
  willOccupy  Boolean  @default(false)
  email       String?
  phoneNumber String?
  status      String?
  notes       String?  @db.Text
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([userId])
  @@index([status])
}

model Watchlist {
  id         String   @id @default(cuid())
  propertyId String
  userId     String
  createdAt  DateTime @default(now())

  // Relations
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@index([propertyId])
  @@index([userId])
}

model ProjectMessage {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  message   String   @db.Text
  createdAt DateTime @default(now())

  // Relations
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation("MessageSender", fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

