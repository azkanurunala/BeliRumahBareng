generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                    @id @default(cuid())
  name                     String
  email                    String                    @unique
  phoneNumber              String
  avatarUrl                String
  avatarHint               String
  passwordHash             String?
  oauthProvider            String?
  oauthId                  String?
  locationPreference       String
  priceRange               String
  investmentGoals          String
  financialCapacity        String
  timeHorizon              String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  role                     Int                       @default(1)
  activityLogs             ActivityLog[]             @relation("ActivityActor")
  checklistItemCompletions ChecklistItemCompletion[] @relation("ChecklistItemCompleter")
  documentSignatures       DocumentSignature[]       @relation("DocumentSigner")
  interviewRecords         InterviewRecord[]         @relation("Interviewer")
  notifications            Notification[]
  payments                 Payment[]
  verifiedPayments         Payment[]                 @relation("PaymentVerifier")
  paymentPlans             PaymentPlan[]
  progressCompletions      ProgressCompletedMember[] @relation("ProgressCompleter")
  uploadedDocs             ProjectDocument[]         @relation("DocumentUploader")
  projectsAsMember         ProjectMember[]
  messages                 ProjectMessage[]          @relation("MessageSender")
  interests                PropertyInterest[]
  submissionReviews        PropertySubmission[]      @relation("SubmissionReviewer")
  submissions              PropertySubmission[]
  purchaseTransactions     PurchaseTransaction[]
  unitAssignments          UnitAssignment[]          @relation("UnitOwner")
  watchlists               Watchlist[]
}

model Property {
  id                    String             @id @default(cuid())
  name                  String
  description           String
  price                 Decimal            @db.Decimal(15, 2)
  totalArea             Decimal?           @db.Decimal(10, 2)
  location              String
  type                  String
  totalUnits            Int?
  unitName              String
  unitSize              Decimal?           @db.Decimal(10, 2)
  unitMeasure           String?
  sitePlanUrl           String?
  sitePlanHint          String?
  developmentPlan       String?
  environmentalAnalysis String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  projects              Project[]
  images                PropertyImage[]
  interests             PropertyInterest[]
  watchlists            Watchlist[]
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  hint       String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Project {
  id                   String                @id @default(cuid())
  propertyId           String
  propertyName         String
  propertyImageUrl     String
  propertyImageHint    String
  status               String?
  kycProgress          Int                   @default(0)
  fundingProgress      Int                   @default(0)
  legalProgress        Int                   @default(0)
  closingProgress      Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  payments             Payment[]
  paymentPlans         PaymentPlan[]
  progressDetails      ProgressDetail[]
  property             Property              @relation(fields: [propertyId], references: [id])
  documents            ProjectDocument[]
  members              ProjectMember[]
  messages             ProjectMessage[]
  purchaseTransactions PurchaseTransaction[]
  unitAssignments      UnitAssignment[]
}

model PaymentPlan {
  id                String    @id @default(cuid())
  projectId         String
  userId            String
  unitId            Int
  type              String
  totalAmount       Decimal   @db.Decimal(15, 2)
  downPayment       Decimal?  @db.Decimal(15, 2)
  installmentAmount Decimal?  @db.Decimal(15, 2)
  totalInstallments Int?
  startDate         DateTime?
  endDate           DateTime?
  status            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bookingFeeAmount  Decimal?  @db.Decimal(15, 2)
  bookingFeePaid    Boolean   @default(false)
  paymentType       String?
  payments          Payment[]
  project           Project   @relation(fields: [projectId], references: [id])
  user              User      @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model Payment {
  id               String       @id @default(cuid())
  paymentPlanId    String?
  projectId        String
  userId           String
  unitId           Int
  amount           Decimal      @db.Decimal(15, 2)
  paymentDate      DateTime?
  dueDate          DateTime?
  period           String?
  status           String
  paymentMethod    String?
  receiptUrl       String?
  paymentReference String?
  notes            String?
  verifiedBy       String?
  verifiedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  paymentPlan      PaymentPlan? @relation(fields: [paymentPlanId], references: [id])
  project          Project      @relation(fields: [projectId], references: [id])
  user             User         @relation(fields: [userId], references: [id])
  verifier         User?        @relation("PaymentVerifier", fields: [verifiedBy], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([paymentPlanId])
  @@index([status])
  @@index([period])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String
  href        String?
  type        String
  read        Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([type])
}

model PropertySubmission {
  id            String                    @id @default(cuid())
  submittedBy   String
  type          String
  name          String
  description   String
  location      String
  totalArea     Decimal?                  @db.Decimal(10, 2)
  totalUnits    Int?
  unitSize      Decimal?                  @db.Decimal(10, 2)
  unitMeasure   String?
  askingPrice   Decimal                   @db.Decimal(15, 2)
  contactPerson String
  contactPhone  String
  contactEmail  String
  status        String
  reviewedBy    String?
  reviewedAt    DateTime?
  notes         String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  reviewer      User?                     @relation("SubmissionReviewer", fields: [reviewedBy], references: [id])
  submitter     User                      @relation(fields: [submittedBy], references: [id])
  images        PropertySubmissionImage[]

  @@index([submittedBy])
  @@index([status])
  @@index([createdAt])
}

model PropertySubmissionImage {
  id                   String             @id @default(cuid())
  propertySubmissionId String
  url                  String
  hint                 String
  order                Int                @default(0)
  createdAt            DateTime           @default(now())
  propertySubmission   PropertySubmission @relation(fields: [propertySubmissionId], references: [id], onDelete: Cascade)

  @@index([propertySubmissionId])
}

model ProgressDetail {
  id               String                    @id @default(cuid())
  projectId        String
  category         String
  title            String
  percentage       Int                       @default(0)
  description      String?
  notes            String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  checklist        ProgressChecklistItem[]
  completedMembers ProgressCompletedMember[]
  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestones       ProgressMilestone[]

  @@unique([projectId, category])
  @@index([projectId])
  @@index([category])
}

model ProgressChecklistItem {
  id               String                    @id @default(cuid())
  progressDetailId String
  label            String
  order            Int                       @default(0)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  completions      ChecklistItemCompletion[]
  progressDetail   ProgressDetail            @relation(fields: [progressDetailId], references: [id], onDelete: Cascade)

  @@index([progressDetailId])
}

model ChecklistItemCompletion {
  id              String                @id @default(cuid())
  checklistItemId String
  userId          String
  completedAt     DateTime              @default(now())
  checklistItem   ProgressChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  user            User                  @relation("ChecklistItemCompleter", fields: [userId], references: [id])

  @@unique([checklistItemId, userId])
  @@index([checklistItemId])
  @@index([userId])
}

model ProgressCompletedMember {
  id               String         @id @default(cuid())
  progressDetailId String
  userId           String
  completedAt      DateTime       @default(now())
  progressDetail   ProgressDetail @relation(fields: [progressDetailId], references: [id], onDelete: Cascade)
  user             User           @relation("ProgressCompleter", fields: [userId], references: [id])

  @@unique([progressDetailId, userId])
  @@index([progressDetailId])
  @@index([userId])
}

model ProgressMilestone {
  id               String         @id @default(cuid())
  progressDetailId String
  label            String
  date             DateTime?
  status           String
  order            Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  progressDetail   ProgressDetail @relation(fields: [progressDetailId], references: [id], onDelete: Cascade)

  @@index([progressDetailId])
  @@index([status])
}

model ProjectDocument {
  id          String              @id @default(cuid())
  projectId   String
  name        String
  status      String
  url         String?
  uploadDate  DateTime?
  size        Int?
  description String?
  uploadedBy  String?
  verifiedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  signatures  DocumentSignature[]
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader    User?               @relation("DocumentUploader", fields: [uploadedBy], references: [id])

  @@index([projectId])
  @@index([status])
  @@index([uploadedBy])
}

model DocumentSignature {
  id         String          @id @default(cuid())
  documentId String
  userId     String
  signedAt   DateTime        @default(now())
  document   ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User            @relation("DocumentSigner", fields: [userId], references: [id])

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String?
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model UnitAssignment {
  id        String    @id @default(cuid())
  projectId String
  unitId    Int
  userId    String
  price     Decimal   @db.Decimal(15, 2)
  size      Decimal?  @db.Decimal(10, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isLocked  Boolean   @default(false)
  lockedAt  DateTime?
  lockedBy  String?
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation("UnitOwner", fields: [userId], references: [id])

  @@unique([projectId, unitId])
  @@index([projectId])
  @@index([userId])
  @@index([isLocked])
}

model PropertyInterest {
  id          String    @id @default(cuid())
  propertyId  String
  userId      String
  unitId      Int?
  unitSize    Decimal?  @db.Decimal(10, 2)
  isFirstHome Boolean   @default(false)
  willOccupy  Boolean   @default(false)
  email       String?
  phoneNumber String?
  status      String?
  notes       String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([userId])
  @@index([status])
}

model Watchlist {
  id         String   @id @default(cuid())
  propertyId String
  userId     String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@index([propertyId])
  @@index([userId])
}

model ProjectMessage {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  message   String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation("MessageSender", fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

model PurchaseTransaction {
  id                      String                   @id @default(cuid())
  projectId               String
  userId                  String
  unitId                  Int
  state                   String
  paymentType             String?
  bookingFeeAmount        Decimal?                 @db.Decimal(15, 2)
  bookingDate             DateTime?
  paymentProofUrl         String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  activityLogs            ActivityLog[]
  appointments            Appointment[]
  constructionCheckpoints ConstructionCheckpoint[]
  interviewRecord         InterviewRecord?
  kprStatus               KprStatus?
  project                 Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                    User                     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId, unitId])
  @@index([projectId])
  @@index([userId])
  @@index([state])
  @@index([paymentType])
}

model InterviewRecord {
  id            String              @id @default(cuid())
  transactionId String              @unique
  interviewDate DateTime
  interviewerId String
  result        String
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  interviewer   User                @relation("Interviewer", fields: [interviewerId], references: [id])
  transaction   PurchaseTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([result])
  @@index([interviewDate])
}

model Appointment {
  id            String              @id @default(cuid())
  transactionId String
  type          String
  scheduledDate DateTime
  status        String
  location      String?
  notes         String?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  transaction   PurchaseTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([type])
  @@index([status])
  @@index([scheduledDate])
}

model KprStatus {
  id              String              @id @default(cuid())
  transactionId   String              @unique
  status          String
  bankName        String?
  submittedDate   DateTime?
  approvedDate    DateTime?
  rejectedDate    DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  transaction     PurchaseTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([status])
}

model ConstructionCheckpoint {
  id            String              @id @default(cuid())
  transactionId String
  progress      Int
  milestone     String
  status        String
  startDate     DateTime?
  completedDate DateTime?
  photos        String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  transaction   PurchaseTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, progress])
  @@index([transactionId])
  @@index([status])
}

model ActivityLog {
  id            String              @id @default(cuid())
  transactionId String
  action        String
  actorId       String
  actorRole     String
  fromState     String?
  toState       String?
  details       String?
  createdAt     DateTime            @default(now())
  actor         User                @relation("ActivityActor", fields: [actorId], references: [id])
  transaction   PurchaseTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}
